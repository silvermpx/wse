{
  "name": "wse-client",
  "version": "3.1.0",
  "description": "TypeScript client for WSE: a core without a framework, with React, Vue, Svelte, Angular and Solid adapters and the React hook useWSE; topics with message recovery, reconnects, an offline queue, end-to-end encryption and signed messages.",
  "type": "module",
  "main": "./dist/npm/index.js",
  "types": "./dist/npm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/npm/index.d.ts",
      "import": "./dist/npm/index.js",
      "default": "./dist/npm/index.js"
    },
    "./core": {
      "types": "./dist/npm/core/index.d.ts",
      "import": "./dist/npm/core/index.js",
      "default": "./dist/npm/core/index.js"
    },
    "./react": {
      "types": "./dist/npm/react/index.d.ts",
      "import": "./dist/npm/react/index.js",
      "default": "./dist/npm/react/index.js"
    },
    "./vue": {
      "types": "./dist/npm/vue/index.d.ts",
      "import": "./dist/npm/vue/index.js",
      "default": "./dist/npm/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/npm/svelte/index.d.ts",
      "import": "./dist/npm/svelte/index.js",
      "default": "./dist/npm/svelte/index.js"
    },
    "./angular": {
      "types": "./dist/npm/angular/index.d.ts",
      "import": "./dist/npm/angular/index.js",
      "default": "./dist/npm/angular/index.js"
    },
    "./solid": {
      "types": "./dist/npm/solid/index.d.ts",
      "import": "./dist/npm/solid/index.js",
      "default": "./dist/npm/solid/index.js"
    },
    "./react-native": {
      "types": "./dist/npm/react-native/index.d.ts",
      "import": "./dist/npm/react-native/index.js",
      "default": "./dist/npm/react-native/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/npm/core/index.d.ts"
      ],
      "react": [
        "./dist/npm/react/index.d.ts"
      ],
      "vue": [
        "./dist/npm/vue/index.d.ts"
      ],
      "svelte": [
        "./dist/npm/svelte/index.d.ts"
      ],
      "angular": [
        "./dist/npm/angular/index.d.ts"
      ],
      "solid": [
        "./dist/npm/solid/index.d.ts"
      ],
      "react-native": [
        "./dist/npm/react-native/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/npm/"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist/npm', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node --input-type=module -e \"const m = await import('wse-client'); if (typeof m.useWSE !== 'function') throw new Error('useWSE missing'); console.log('wse-client ESM import OK:', Object.keys(m).length, 'exports')\"",
    "prepublishOnly": "npm run build && npm run smoke"
  },
  "keywords": [
    "websocket",
    "react",
    "hooks",
    "real-time",
    "events",
    "pubsub",
    "encryption",
    "rust",
    "zustand",
    "vue",
    "svelte",
    "angular",
    "solid",
    "typescript",
    "react-native"
  ],
  "author": "silvermpx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermpx/wse.git",
    "directory": "ts-client"
  },
  "homepage": "https://github.com/silvermpx/wse",
  "bugs": {
    "url": "https://github.com/silvermpx/wse/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./dist/npm/react-native/textCodec.js"
  ],
  "publishConfig": {
    "provenance": true
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "pako": "^3.0.3"
  },
  "peerDependencies": {
    "@angular/common": ">=20.0.0",
    "@angular/core": ">=20.0.0",
    "react": ">=18",
    "solid-js": "^1.9.0 || >=2.0.0-rc.23 <3",
    "vue": ">=3.3",
    "zustand": ">=4"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.19",
    "solid-js-next": "npm:solid-js@^2.0.0-rc.23",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "zone.js": "^0.16.3",
    "zustand": "^5.1.0"
  }
}
