{
  "name": "wse-client",
  "version": "3.0.0",
  "description": "WSE (WebSocket Engine) React client. Type-safe hooks, auto-reconnect, offline queue, E2E encryption.",
  "type": "module",
  "main": "./dist/npm/index.js",
  "types": "./dist/npm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/npm/index.d.ts",
      "import": "./dist/npm/index.js",
      "default": "./dist/npm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/npm/"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist/npm', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node --input-type=module -e \"const m = await import('wse-client'); if (typeof m.useWSE !== 'function') throw new Error('useWSE missing'); console.log('wse-client ESM import OK:', Object.keys(m).length, 'exports')\"",
    "prepublishOnly": "npm run build && npm run smoke"
  },
  "keywords": [
    "websocket",
    "react",
    "hooks",
    "real-time",
    "events",
    "pubsub",
    "encryption",
    "rust",
    "zustand"
  ],
  "author": "silvermpx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/silvermpx/wse.git",
    "directory": "ts-client"
  },
  "homepage": "https://github.com/silvermpx/wse",
  "bugs": {
    "url": "https://github.com/silvermpx/wse/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "provenance": true
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "pako": "^3.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "zustand": ">=4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
